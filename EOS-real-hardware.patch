+void irq_set_mask(u8 irq, u8 masked) {
+    u16 port = (irq < 8) ? 0x21 : 0xA1;
+    u8  bit  = (irq < 8) ? irq  : (u8)(irq - 8);
+    u8  cur  = port_byte_in(port);
