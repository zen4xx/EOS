 void memcpy(void* dest, void* src, u32 n){
-	char* m_dest = dest;
-	char* m_src = src;
+	char* m_dest = (char*)dest;
+	const char* m_src = (const char*)src;
 	while(n--)
 		*m_dest++ = *m_src++;
